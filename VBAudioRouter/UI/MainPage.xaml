<Page
    x:Class="VBAudioRouter.UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:VBAudioRouter.UI" xmlns:enumeration="using:Windows.Devices.Enumeration"
    mc:Ignorable="d">

    <NavigationView PaneDisplayMode="Top" MenuItemsSource="{x:Bind RenderDeviceWatcher.RenderDevices}"
                    SelectionFollowsFocus="Enabled" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    SelectionChanged="NavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Default Speaker">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xe8d6;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.MenuItemTemplate>
            <DataTemplate x:DataType="enumeration:DeviceInformation">
                <NavigationViewItem Content="{x:Bind Name, Mode=OneWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xe7f5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </DataTemplate>
        </NavigationView.MenuItemTemplate>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
